package main

// bannerTrackingJS fires Plausible custom events for banners.
// It runs once per page (guarded by window.__njumpBanners) and:
//   - fires "Banner View" for every banner that is actually displayed
//     (hidden responsive duplicates, e.g. mobile/desktop copies, are skipped)
//   - fires "Banner Click" when a banner link is clicked
// Each event carries props: { id: <banner id>, position: <top|left|right|bottom> }
const bannerTrackingJS = `(function(){
  if (window.__njumpBanners) return;
  window.__njumpBanners = true;
  function visible(el){ try { return window.getComputedStyle(el).display !== 'none'; } catch(e){ return true; } }
  function fire(name, props){ if (window.plausible) { try { window.plausible(name, { props: props }); } catch(e){} } }
  function init(){
    document.querySelectorAll('.banner-container').forEach(function(c){
      if (!visible(c)) return;
      var pos = c.getAttribute('data-position') || '';
      c.querySelectorAll('[data-banner-id]').forEach(function(b){
        fire('Banner View', { id: b.getAttribute('data-banner-id') || '', position: pos });
      });
    });
    document.querySelectorAll('.banner-container [data-banner-id] a').forEach(function(a){
      if (a.getAttribute('data-njump-tracked')) return;
      a.setAttribute('data-njump-tracked', '1');
      a.addEventListener('click', function(){
        var b = a.closest('[data-banner-id]');
        var c = a.closest('.banner-container');
        if (!b || !c) return;
        fire('Banner Click', { id: b.getAttribute('data-banner-id') || '', position: c.getAttribute('data-position') || '' });
      });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();`

// BannerItemParams holds parameters for rendering a single banner
type BannerItemParams struct {
	ID      string
	Type    string
	Text    string
	HTML    string
	URL     string
	Src     string
	Class   string
	AltText string
	NewTab  bool
}

// BannerContainerParams holds all banners for a specific position
type BannerContainerParams struct {
	Position string
	Banners  []BannerItemParams
}

// renderBannerItem renders a single banner based on its type
templ bannerItemTemplate(params BannerItemParams) {
	if params.Type == "html" && params.HTML != "" {
		<div id={ "banner-" + params.ID } data-banner-id={ params.ID } class={ "njump-banner " + params.Class }>
			@templ.Raw(params.HTML)
		</div>
	}
	if params.Type == "link" && params.URL != "" {
		<div id={ "banner-" + params.ID } data-banner-id={ params.ID } class={ "njump-banner " + params.Class }>
			<a
				href={ templ.URL(params.URL) }
				if params.NewTab {
					target="_blank"
					rel="noopener noreferrer"
				}
				class="block hover:opacity-80 transition-opacity"
			>
				if params.Text != "" {
					<span>{ params.Text }</span>
				}
				if params.AltText != "" {
					<span class="sr-only">{ params.AltText }</span>
				}
			</a>
		</div>
	}
	if params.Type == "text" && params.Text != "" {
		<div id={ "banner-" + params.ID } data-banner-id={ params.ID } class={ "njump-banner " + params.Class }>
			{ params.Text }
		</div>
	}
	if params.Type == "image" && params.Src != "" {
		if params.URL != "" {
			<div id={ "banner-" + params.ID } data-banner-id={ params.ID } class={ "njump-banner " + params.Class }>
				<a
					href={ templ.URL(params.URL) }
					if params.NewTab {
						target="_blank"
						rel="noopener noreferrer"
					}
					class="block hover:opacity-80 transition-opacity"
				>
					<img src={ templ.URL(params.Src) } alt={ params.AltText } class="h-auto max-w-full"/>
				</a>
			</div>
		} else {
			<div id={ "banner-" + params.ID } data-banner-id={ params.ID } class={ "njump-banner " + params.Class }>
				<img src={ templ.URL(params.Src) } alt={ params.AltText } class="h-auto max-w-full"/>
			</div>
		}
	}
}

// bannerContainerTemplate renders all banners for a position.
// Left and right positions are fixed vertical sidebars at the viewport edges
// with vertical-running text (writing-mode) so they read like a long vertical strip.
templ bannerContainerTemplate(params BannerContainerParams) {
	if len(params.Banners) > 0 {
		if params.Position == "left" {
			<aside
				class="banner-container banner-container--left fixed left-0 top-24 z-40 flex max-h-[calc(100vh-8rem)] flex-col items-center justify-start gap-2 px-1 py-4 print:hidden lg:flex"
				data-position="left"
			>
				for _, banner := range params.Banners {
					<div class="[writing-mode:vertical-rl] rotate-180">
						@bannerItemTemplate(banner)
					</div>
				}
			</aside>
		} else if params.Position == "right" {
			<aside
				class="banner-container banner-container--right fixed right-0 top-24 z-40 flex max-h-[calc(100vh-8rem)] flex-col items-center justify-start gap-2 px-1 py-4 print:hidden lg:flex"
				data-position="right"
			>
				for _, banner := range params.Banners {
					<div class="[writing-mode:vertical-rl]">
						@bannerItemTemplate(banner)
					</div>
				}
			</aside>
		} else {
			<div
				class={ "banner-container banner-container--" + params.Position }
				data-position={ params.Position }
			>
				for _, banner := range params.Banners {
					@bannerItemTemplate(banner)
				}
			</div>
		}
		// Plausible tracking (idempotent: runs once per page)
		@templ.Raw("<script>" + bannerTrackingJS + "</script>")
	}
}

// Template for rendering banners for a domain and position
templ bannersForPosition(domain string, position BannerPosition) {
	@bannerContainerTemplate(GetBannerParams(domain, position))
}
